# Optional shell environment; the service does not automatically load .env files.
# Set :8090 to listen on all interfaces (the container default).
BOTS_HTTP_ADDR=127.0.0.1:8090
BOTS_SHUTDOWN_TIMEOUT=10s
BOTS_DATABASE_URL=postgres://chronotope:chronotope_dev@127.0.0.1:5432/chronotope?sslmode=disable
BOTS_SEED_PATH=configs/bot.yaml
BOTS_CHRONOTOPE_URL=http://127.0.0.1:8080
BOTS_POLL_INTERVAL=1s
# Reference names can be changed with BOTS_*_TOKEN_ENV. Values belong only here
# or in your deployment secret store, never in bot YAML / source / audit.
BOTS_CHRONOTOPE_TOKEN=
BOTS_ADMIN_TOKEN=
APPLICATION_SERVICE_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Socket Mode uses the existing app-level token with connections:write.
# Select event_transport: socket and app_token_env in the Bot seed.
SLACK_APP_TOKEN=
