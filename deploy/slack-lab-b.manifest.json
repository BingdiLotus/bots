{
  "display_information": {
    "name": "Bingdi Lab B",
    "description": "Test-only second bot for the Bingdi multi-bot lab"
  },
  "features": {
    "bot_user": {
      "display_name": "bingdi-b",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "chat:write",
        "groups:history"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups"
      ]
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
